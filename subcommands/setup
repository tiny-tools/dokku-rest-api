#!/usr/bin/env bash
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

NGINX_DIR="/var/lib/dokku/data/api/nginx"
ACME_DIR="/var/lib/dokku/data/api/acme"

fn-api-nginx-reload() {
  local systemctl_path=/bin/systemctl
  [[ -x /usr/bin/systemctl ]] && systemctl_path=/usr/bin/systemctl
  if [[ -x "$systemctl_path" ]]; then
    sudo "$systemctl_path" reload nginx
  else
    sudo /etc/init.d/nginx reload
  fi
}

fn-api-proxy-block() {
  declare PORT="$1"
  cat <<NGINX
  client_max_body_size 1m;

  location / {
    proxy_pass http://127.0.0.1:$PORT;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-For \$remote_addr;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_buffering off;
    proxy_read_timeout 960s;
    proxy_send_timeout 960s;
  }
NGINX
}

cmd-api-setup() {
  # shellcheck disable=SC2034
  declare desc="exposes the API daemon on a domain through nginx"
  [[ "$1" == "api:setup" ]] && shift 1
  local DOMAIN="" SSL_CERT="" SSL_KEY=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --domain) DOMAIN="$2" && shift 2 ;;
      --domain=*) DOMAIN="${1#*=}" && shift ;;
      --ssl-cert) SSL_CERT="$2" && shift 2 ;;
      --ssl-cert=*) SSL_CERT="${1#*=}" && shift ;;
      --ssl-key) SSL_KEY="$2" && shift 2 ;;
      --ssl-key=*) SSL_KEY="${1#*=}" && shift ;;
      *) dokku_log_fail "Unknown argument: $1" ;;
    esac
  done

  [[ -n "$DOMAIN" ]] || dokku_log_fail "Usage: dokku api:setup --domain <domain> [--ssl-cert <path> --ssl-key <path>]"
  [[ "$DOMAIN" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || dokku_log_fail "Invalid domain: $DOMAIN"
  if { [[ -n "$SSL_CERT" ]] && [[ -z "$SSL_KEY" ]]; } || { [[ -z "$SSL_CERT" ]] && [[ -n "$SSL_KEY" ]]; }; then
    dokku_log_fail "--ssl-cert and --ssl-key must be given together"
  fi
  for path in "$SSL_CERT" "$SSL_KEY"; do
    [[ -z "$path" ]] || [[ "$path" =~ ^/[A-Za-z0-9._/@-]+$ ]] || dokku_log_fail "Invalid path: $path"
  done
  [[ -d "$NGINX_DIR" ]] && [[ -w "$NGINX_DIR" ]] || dokku_log_fail "$NGINX_DIR is missing; re-run: sudo dokku plugin:install"

  local PORT=5099
  if [[ -r /etc/default/dokku-api ]]; then
    PORT="$(grep -E '^DOKKU_API_PORT=' /etc/default/dokku-api | tail -n1 | cut -d= -f2)"
    PORT="${PORT:-5099}"
  fi

  local CONF="$NGINX_DIR/api.conf" TMP
  TMP="$(mktemp)"
  {
    echo "# Generated by 'dokku api:setup' - do not edit"
    echo "server {"
    echo "  listen 80;"
    echo "  listen [::]:80;"
    echo "  server_name $DOMAIN;"
    echo "  location /.well-known/acme-challenge/ { root $ACME_DIR; }"
    if [[ -n "$SSL_CERT" ]]; then
      echo "  location / { return 301 https://\$host\$request_uri; }"
      echo "}"
      echo "server {"
      echo "  listen 443 ssl;"
      echo "  listen [::]:443 ssl;"
      echo "  server_name $DOMAIN;"
      echo "  ssl_certificate $SSL_CERT;"
      echo "  ssl_certificate_key $SSL_KEY;"
      echo "  ssl_protocols TLSv1.2 TLSv1.3;"
    fi
    fn-api-proxy-block "$PORT"
    echo "}"
  } >"$TMP"

  local BACKUP=""
  if [[ -f "$CONF" ]]; then
    BACKUP="$(mktemp)"
    cp "$CONF" "$BACKUP"
  fi
  mv "$TMP" "$CONF"
  chmod 640 "$CONF"

  local NGINX_BIN
  NGINX_BIN="$(command -v nginx || echo /usr/sbin/nginx)"
  if ! sudo "$NGINX_BIN" -t >/dev/null 2>&1; then
    if [[ -n "$BACKUP" ]]; then mv "$BACKUP" "$CONF"; else rm -f "$CONF"; fi
    sudo "$NGINX_BIN" -t || true
    dokku_log_fail "nginx rejected the generated config; previous config restored"
  fi
  rm -f "$BACKUP"
  fn-api-nginx-reload

  # GitHub OIDC tokens must name this URL as their audience; the action
  # requests them for its dokku_url.
  local SCHEME=http
  [[ -n "$SSL_CERT" ]] && SCHEME=https
  "$(dirname "$0")/../bin/dokku-api" cli set oidc-audience "$SCHEME://$DOMAIN" >/dev/null

  if [[ -n "$SSL_CERT" ]]; then
    dokku_log_info1 "API available at https://$DOMAIN/api/v1"
    dokku_log_info2 "GitHub Actions use dokku_url: https://$DOMAIN"
  else
    dokku_log_info1 "API available at http://$DOMAIN/api/v1"
    dokku_log_warn "No TLS configured - tokens travel in plain text. To add Let's Encrypt:"
    dokku_log_warn "  sudo certbot certonly --webroot -w $ACME_DIR -d $DOMAIN --deploy-hook 'systemctl reload nginx'"
    dokku_log_warn "  dokku api:setup --domain $DOMAIN --ssl-cert /etc/letsencrypt/live/$DOMAIN/fullchain.pem --ssl-key /etc/letsencrypt/live/$DOMAIN/privkey.pem"
  fi
}

cmd-api-setup "$@"
