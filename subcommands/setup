#!/usr/bin/env bash
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

NGINX_DIR="/var/lib/dokku/data/api/nginx"
ACME_DIR="/var/lib/dokku/data/api/acme"
# Installed by the install trigger; the dokku user may run it via sudo (certbot needs root).
CERTBOT_HELPER="/usr/local/sbin/dokku-api-certbot"
# The domain currently served, and the domain whose certificate --letsencrypt manages.
DOMAIN_FILE="$NGINX_DIR/domain"
LETSENCRYPT_FILE="$NGINX_DIR/letsencrypt-domain"

fn-api-nginx-reload() {
  local systemctl_path=/bin/systemctl
  [[ -x /usr/bin/systemctl ]] && systemctl_path=/usr/bin/systemctl
  if [[ -x "$systemctl_path" ]]; then
    sudo "$systemctl_path" reload nginx
  else
    sudo /etc/init.d/nginx reload
  fi
}

fn-api-proxy-block() {
  declare PORT="$1"
  cat <<NGINX
  client_max_body_size 1m;

  location / {
    proxy_pass http://127.0.0.1:$PORT;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-For \$remote_addr;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_buffering off;
    proxy_read_timeout 960s;
    proxy_send_timeout 960s;
  }
NGINX
}

# Writes the nginx config, validates it and reloads nginx. Restores the previous
# config and shows nginx's own error when the new one is rejected.
fn-api-write-config() {
  declare DOMAIN="$1" SSL_CERT="$2" SSL_KEY="$3" PORT="$4"
  local CONF="$NGINX_DIR/api.conf" TMP BACKUP="" NGINX_BIN OUTPUT
  TMP="$(mktemp)"
  {
    echo "# Generated by 'dokku api:setup' - do not edit"
    echo "server {"
    echo "  listen 80;"
    echo "  listen [::]:80;"
    echo "  server_name $DOMAIN;"
    echo "  location /.well-known/acme-challenge/ { root $ACME_DIR; }"
    if [[ -n "$SSL_CERT" ]]; then
      echo "  location / { return 301 https://\$host\$request_uri; }"
      echo "}"
      echo "server {"
      echo "  listen 443 ssl;"
      echo "  listen [::]:443 ssl;"
      echo "  server_name $DOMAIN;"
      echo "  ssl_certificate $SSL_CERT;"
      echo "  ssl_certificate_key $SSL_KEY;"
      echo "  ssl_protocols TLSv1.2 TLSv1.3;"
    fi
    fn-api-proxy-block "$PORT"
    echo "}"
  } >"$TMP"

  if [[ -f "$CONF" ]]; then
    BACKUP="$(mktemp)"
    cp "$CONF" "$BACKUP"
  fi
  mv "$TMP" "$CONF"
  chmod 640 "$CONF"

  NGINX_BIN="$(command -v nginx || echo /usr/sbin/nginx)"
  if ! OUTPUT="$(sudo "$NGINX_BIN" -t 2>&1)"; then
    if [[ -n "$BACKUP" ]]; then mv "$BACKUP" "$CONF"; else rm -f "$CONF"; fi
    echo "$OUTPUT" >&2
    dokku_log_fail "nginx rejected the generated config (see above); the previous config was restored"
  fi
  rm -f "$BACKUP"
  fn-api-nginx-reload
}

# True only when we can tell for sure that a file is missing: the deepest
# directory on its path that we can see is searchable for us. Where it is not
# (/etc/letsencrypt/live usually is root-only), nginx -t decides.
fn-api-surely-missing() {
  declare FILE="$1"
  local DIR
  [[ -e "$FILE" ]] && return 1
  DIR="$(dirname "$FILE")"
  while [[ ! -e "$DIR" ]] && [[ "$DIR" != "/" ]]; do DIR="$(dirname "$DIR")"; done
  [[ -x "$DIR" ]]
}

fn-api-certbot() {
  if [[ ! -x "$CERTBOT_HELPER" ]]; then
    dokku_log_fail "$CERTBOT_HELPER is missing; re-run: sudo dokku plugin:install"
  fi
  sudo -n "$CERTBOT_HELPER" "$@"
}

cmd-api-setup() {
  # shellcheck disable=SC2034
  declare desc="exposes the API daemon on a domain through nginx"
  [[ "$1" == "api:setup" ]] && shift 1
  local DOMAIN="" SSL_CERT="" SSL_KEY="" LETSENCRYPT="" EMAIL="" DELETE_OLD_CERT=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --domain) DOMAIN="$2" && shift 2 ;;
      --domain=*) DOMAIN="${1#*=}" && shift ;;
      --ssl-cert) SSL_CERT="$2" && shift 2 ;;
      --ssl-cert=*) SSL_CERT="${1#*=}" && shift ;;
      --ssl-key) SSL_KEY="$2" && shift 2 ;;
      --ssl-key=*) SSL_KEY="${1#*=}" && shift ;;
      --letsencrypt) LETSENCRYPT=true && shift ;;
      --email) EMAIL="$2" && shift 2 ;;
      --email=*) EMAIL="${1#*=}" && shift ;;
      --delete-old-cert) DELETE_OLD_CERT=true && shift ;;
      *) dokku_log_fail "Unknown argument: $1" ;;
    esac
  done

  [[ -n "$DOMAIN" ]] || dokku_log_fail "Usage: dokku api:setup --domain <domain> [--letsencrypt [--email <email>] [--delete-old-cert] | --ssl-cert <path> --ssl-key <path>]"
  [[ "$DOMAIN" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || dokku_log_fail "Invalid domain: $DOMAIN"
  if { [[ -n "$SSL_CERT" ]] && [[ -z "$SSL_KEY" ]]; } || { [[ -z "$SSL_CERT" ]] && [[ -n "$SSL_KEY" ]]; }; then
    dokku_log_fail "--ssl-cert and --ssl-key must be given together"
  fi
  if [[ -n "$LETSENCRYPT" ]] && [[ -n "$SSL_CERT" ]]; then
    dokku_log_fail "--letsencrypt and --ssl-cert/--ssl-key exclude each other"
  fi
  if [[ -z "$LETSENCRYPT" ]] && { [[ -n "$EMAIL" ]] || [[ -n "$DELETE_OLD_CERT" ]]; }; then
    dokku_log_fail "--email and --delete-old-cert only work with --letsencrypt"
  fi
  for path in "$SSL_CERT" "$SSL_KEY"; do
    [[ -z "$path" ]] || [[ "$path" =~ ^/[A-Za-z0-9._/@-]+$ ]] || dokku_log_fail "Invalid path: $path"
    if [[ -n "$path" ]] && fn-api-surely-missing "$path"; then
      dokku_log_fail "File not found: $path"
    fi
  done
  if [[ ! -d "$NGINX_DIR" ]] || [[ ! -w "$NGINX_DIR" ]]; then
    dokku_log_fail "$NGINX_DIR is missing; re-run: sudo dokku plugin:install"
  fi

  local PORT=5099
  if [[ -r /etc/default/dokku-api ]]; then
    PORT="$(grep -E '^DOKKU_API_PORT=' /etc/default/dokku-api | tail -n1 | cut -d= -f2)"
    PORT="${PORT:-5099}"
  fi

  local PREVIOUS_DOMAIN="" MANAGED_DOMAIN=""
  [[ -r "$DOMAIN_FILE" ]] && PREVIOUS_DOMAIN="$(cat "$DOMAIN_FILE")"
  [[ -r "$LETSENCRYPT_FILE" ]] && MANAGED_DOMAIN="$(cat "$LETSENCRYPT_FILE")"

  if [[ -n "$LETSENCRYPT" ]]; then
    # The challenge is answered on port 80. Both configs serve it, so only a
    # new domain needs a plain HTTP config first.
    if [[ "$PREVIOUS_DOMAIN" != "$DOMAIN" ]]; then
      fn-api-write-config "$DOMAIN" "" "" "$PORT"
      echo "$DOMAIN" >"$DOMAIN_FILE"
    fi
    dokku_log_info1 "Requesting a Let's Encrypt certificate for $DOMAIN"
    if ! fn-api-certbot issue "$DOMAIN" ${EMAIL:+"$EMAIL"}; then
      dokku_log_fail "certbot failed; $DOMAIN must point to this server and port 80 must be reachable"
    fi
    SSL_CERT="/etc/letsencrypt/live/$DOMAIN/fullchain.pem"
    SSL_KEY="/etc/letsencrypt/live/$DOMAIN/privkey.pem"
  fi

  fn-api-write-config "$DOMAIN" "$SSL_CERT" "$SSL_KEY" "$PORT"
  echo "$DOMAIN" >"$DOMAIN_FILE"

  if [[ -n "$LETSENCRYPT" ]]; then
    echo "$DOMAIN" >"$LETSENCRYPT_FILE"
    if [[ -n "$MANAGED_DOMAIN" ]] && [[ "$MANAGED_DOMAIN" != "$DOMAIN" ]]; then
      if [[ -n "$DELETE_OLD_CERT" ]]; then
        dokku_log_info1 "Deleting the certificate for $MANAGED_DOMAIN"
        fn-api-certbot delete "$MANAGED_DOMAIN"
      else
        dokku_log_warn "The certificate for $MANAGED_DOMAIN is still renewed. Remove it with:"
        dokku_log_warn "  sudo certbot delete --cert-name $MANAGED_DOMAIN"
      fi
    fi
  elif [[ -n "$MANAGED_DOMAIN" ]]; then
    rm -f "$LETSENCRYPT_FILE"
    dokku_log_warn "The Let's Encrypt certificate for $MANAGED_DOMAIN is no longer used but still renewed. Remove it with:"
    dokku_log_warn "  sudo certbot delete --cert-name $MANAGED_DOMAIN"
  fi

  # GitHub OIDC tokens must name this URL as their audience; the action
  # requests them for its dokku_url.
  local SCHEME=http
  [[ -n "$SSL_CERT" ]] && SCHEME=https
  "$(dirname "$0")/../bin/dokku-api" cli set oidc-audience "$SCHEME://$DOMAIN" >/dev/null

  if [[ -n "$SSL_CERT" ]]; then
    dokku_log_info1 "API available at https://$DOMAIN/api/v1"
    dokku_log_info2 "GitHub Actions use dokku_url: https://$DOMAIN"
    [[ -n "$LETSENCRYPT" ]] && dokku_log_info2 "The certificate renews automatically (certbot's timer) and nginx reloads after each renewal"
  else
    dokku_log_info1 "API available at http://$DOMAIN/api/v1"
    dokku_log_warn "No TLS configured - tokens travel in plain text. Add Let's Encrypt with:"
    dokku_log_warn "  dokku api:setup --domain $DOMAIN --letsencrypt [--email you@example.com]"
  fi
  return 0
}

cmd-api-setup "$@"
